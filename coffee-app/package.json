{
  "name": "satu-lorong-ttdi-ios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ios:open": "open ios/SatuLorongTTDI.xcodeproj",
    "ios:build": "xcodebuild -project ios/SatuLorongTTDI.xcodeproj -scheme SatuLorongTTDI -sdk iphonesimulator -configuration Debug build CODE_SIGNING_ALLOWED=NO"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
