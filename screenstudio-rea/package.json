{
  "name": "ssstudio",
  "version": "4.0.4-rea",
  "description": "SSStudio — Screen Studio reconstruction built from REA reverse-engineering evidence (Electron + React + Spring Physics + WebCodecs/Canvas Stage + tRPC IPC)",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
